<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Your Profile', css: 'account' }) %>

<body>
    <%- include('partials/header', { title: 'Travellens' }) %>

    <div class="account-container">
        <div class="account-header">
            <h1 class="account-title">Your Profile</h1>
        </div>
        <div class="account-info">
            <div class="info-row">
                <span class="info-label">Username</span>
                <span class="info-value"><%= user.username %></span>
            </div>

            <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value"><%= user.email %></span>
            </div>
        </div>

        <div class="action-row">
            <button class="edit-btn" onclick="openModal()">Edit Profile</button>
        </div>

        <div class="logout-button">
            <a href="/auth/logout" class="logout-link">Logout</a>
        </div>

        <div class="delete-row">
            <button class="delete-btn" onclick="openDeleteModal()">Delete Account</button>
        </div>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal-bg" id="modalBg">
        <div class="modal">
            <span class="close-btn" onclick="closeModal()">×</span>

            <h2 class="modal-title">Edit Profile</h2>

            <form id="edit-profile-form">
                
                <div class="edit-field">
                    <label>Username</label>
                    <input type="text" name="username" id="edit-username" value="<%= user.username %>" data-current-username="<%= user.username %>" required>
                    <span class="error-text" id="edit-username-error"></span>
                </div>

                <div class="edit-field">
                    <label>New Password (optional)</label>
                    <input type="password" name="password" id="edit-password" placeholder="Enter new password">
                    <span class="error-text" id="edit-password-error"></span>
                </div>

                <div id="edit-general-error" class="error-text"></div>
                <button type="submit" class="edit-submit">Save Changes</button>
            </form>

        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-bg" id="deleteModal">
        <div class="modal">
            <span class="close-btn" onclick="closeDeleteModal()">×</span>

            <h2 class="modal-title danger">Confirm Delete</h2>

            <p class="modal-text">
                This action will <b>permanently delete your account</b> and all saved data.
            </p>

            <form action="/auth/delete-account" method="POST">
                <button type="submit" class="delete-submit">Yes, Delete My Account</button>
            </form>

            <button onclick="closeDeleteModal()" class="edit-submit mt-10">
                Cancel
            </button>
        </div>
    </div>

    <script src="/js/account.js"></script>

    <%- include('partials/footer') %>
</body>
</html>
