<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Login', css: 'auth' }) %>
<body>

  <div class="auth-container">
    <div class="heading">
      <img src="/images/logo1.png" alt="Travel Lens Logo" class="logo">
      <h1 class="title">Travellens</h1>
    </div>
    <img src="/images/signup.png" alt="Traveler Illustration" class="illustration">

    <div class="auth-card">
      <form class="auth-form" id="login-form">
        <div class="input-group">
          <input type="text" name="email" placeholder="Email" id="login-name" required>
          <span class="error-text" id="email-error"></span>
        </div>
        <div class="input-group">
          <input type="password" name="password" placeholder="Password" id="login-password" required>
          <span class="error-text" id="password-error"></span>
        </div>
        <span class="error-text" id="login-error"></span>
        <button type="submit" class="auth-submit">Log in</button>

        <p class="switch">or</p>
        <a href="/signup" class="switch-btn">Sign Up</a>
      </form>
    </div>

    <script src="/js/login.js"></script>
    <p class="tagline">See it, Snap it, Know it</p>
  </div>
   
  <script src="/js/script.js"></script>
</body>
</html>
 