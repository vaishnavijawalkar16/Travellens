<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Home', css: 'home' }) %>
<body>
  <%- include('partials/header', { title: 'Travellens' }) %>

  <main class="home-container">
    <h3>Welcome Back, <%= userName || "Traveler" %>!</h3>

    <form id="uploadForm" action="/search/image" method="POST" enctype="multipart/form-data">
      <input id="camera-input" type="file" name="image" accept="image/*" capture="environment" class="hidden-input">
      <input id="gallery-input" type="file" name="image" accept="image/*" class="hidden-input">
      
      <div class="snap-actions">
        <button type="button" class="snap-btn camera" id="snap-btn">
          <i class="fa-solid fa-camera"></i> Tap to Snap
        </button>
        <button type="button" class="snap-btn gallery" id="gallery-btn">
          <i class="fa-solid fa-image"></i> Upload from Gallery
        </button>
      </div>
    </form>

    <h3>Recent Searches</h3>
    <div class="cards">
      <% if (recentSearches && recentSearches.length > 0) { %>
        <% recentSearches.forEach(search => { %>
          <div class="card" onclick="location.href='/details/<%= search._id %>'">
            <img src="<%= search.imageUrl || '/images/default-landmark.jpg' %>" alt="<%= search.landmarkName %>">
            <h4><%= search.landmarkName %></h4>
            <p><small><%= new Date(search.createdAt).toLocaleString() %></small></p>
          </div>
        <% }) %>
      <% } else { %>
        <p class="no-searches">No recent searches yet.</p>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/home.js"></script>
</body>
</html>
